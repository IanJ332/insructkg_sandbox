# Copy values into ignored local config only after future model-use authorization.
# Keep deterministic until then. This file does not start or configure a server.
SIIP_FEEDBACK_PROVIDER=deterministic
SIIP_LLM_BASE_URL=http://127.0.0.1:11434/v1
SIIP_LLM_MODEL=replace-with-approved-local-model-id
SIIP_LLM_API_KEY=
SIIP_LLM_MAX_TOKENS=350
SIIP_LLM_TIMEOUT_SECONDS=8
SIIP_LLM_RETRIES=0
SIIP_ALLOW_PAID_API=
