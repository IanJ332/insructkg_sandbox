# Default: deterministic development feedback, no paid inference.
SIIP_FEEDBACK_PROVIDER=deterministic
SIIP_LLM_BASE_URL=http://127.0.0.1:8000/v1
SIIP_LLM_MODEL=local-model
SIIP_LLM_API_KEY=
# Optional upstream extraction (separate environment only):
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SIIP_EXTRACTION_MODEL=
# Future authorized API adapter (not automatically used):
PRAIRIELEARN_BASE_URL=http://localhost:3000
PRAIRIELEARN_PRIVATE_TOKEN=
PRAIRIELEARN_COURSE_INSTANCE_ID=
PRAIRIELEARN_ASSESSMENT_INSTANCE_ID=
SIIP_PSEUDONYM_SECRET=
# Limits apply equally across Baseline/RAG/KG. Zero retries avoids duplicate billing.
SIIP_LLM_TIMEOUT_SECONDS=8
SIIP_LLM_MAX_TOKENS=350
SIIP_LLM_RETRIES=0
# Leave blank. Set only after explicit user approval of this provider/model and spending.
SIIP_ALLOW_PAID_API=
# Synthetic analytics overrides (loopback only):
SIIP_DASHBOARD_PORT=8080
# SIIP_DB_PATH=/absolute/path/to/synthetic.sqlite3
# Optional CI/contract fixture directory; leave unset for the local research graph.
# SIIP_DATA_DIR=
# Follow-up local synthetic API synchronizer (no token created or used in this phase).
SIIP_PL_API_TOKEN=
# Future local API extraction uses Responses, not feedback's Chat Completions:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# Local in-process LLM_PROVIDER=vllm/hf/local needs a GPU runtime, no paid API key.
